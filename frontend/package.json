{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check-secrets": "node scripts/check_bundle_secrets.mjs",
    "screenshots": "node --experimental-strip-types scripts/capture_screenshots.ts",
    "verify:walkthrough": "node --experimental-strip-types scripts/verify_demo_walkthrough.ts",
    "generate:types": "python ../tools/export_openapi.py && openapi-typescript openapi.json -o src/lib/api/generated.ts",
    "record-fixtures": "node scripts/record_fixtures.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
