            "title": "Persona"
          },
          "top_categories": {
            "description": "Top preferred categories",
            "items": {
              "type": "string"
            },
            "title": "Top Categories",
            "type": "array"
          },
          "user_id": {
            "description": "User unique identifier",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "UserSummary",
        "type": "object"
      },
      "UsersResponse": {
        "description": "Response schema for /v1/types/{type}/users.",
        "properties": {
          "content_type": {
            "description": "Content type identifier",
            "title": "Content Type",
            "type": "string"
          },
          "total": {
            "description": "Total users matching query",
            "title": "Total",
            "type": "integer"
          },
          "users": {
            "description": "List of user profiles",
            "items": {
              "$ref": "#/components/schemas/UserSummary"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": [
          "content_type",
          "total",
          "users"
        ],
        "title": "UsersResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
