            "type": "boolean"
          },
          "user_count": {
            "default": 0,
            "description": "Total unique users in training/evaluation",
            "title": "User Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name",
          "card_type",
          "supports_cold_start"
        ],
        "title": "TypeInfo",
        "type": "object"
      },
      "TypesResponse": {
        "description": "Response schema for /v1/types.",
        "properties": {
          "types": {
            "description": "List of registered content types",
            "items": {
              "$ref": "#/components/schemas/TypeInfo"
            },
            "title": "Types",
            "type": "array"
          }
        },
        "required": [
          "types"
        ],
        "title": "TypesResponse",
        "type": "object"
      },
      "UserProfileResponse": {
        "description": "Response schema for /v1/users/{user_id}/profile.",
        "properties": {
          "content_type": {
            "description": "Content type identifier",
            "title": "Content Type",
            "type": "string"
          },
          "first_activity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Earliest interaction timestamp",
            "title": "First Activity"
          },
          "interaction_count": {
            "description": "Total historical interactions",
            "title": "Interaction Count",
            "type": "integer"
          },
          "last_activity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Latest interaction timestamp",
            "title": "Last Activity"
          },
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Assigned behavioral persona label",
            "title": "Persona"
          },
          "positive_count": {
            "description": "Positive / high-signal interactions",
            "title": "Positive Count",
            "type": "integer"
          },
          "recent_items": {
            "description": "Most recent interactions (up to 10)",
            "items": {
              "$ref": "#/components/schemas/RecentInteraction"
            },
            "title": "Recent Items",
            "type": "array"
          },
          "top_categories": {
            "description": "Ranked category preferences",
            "items": {
              "$ref": "#/components/schemas/CategoryShare"
            },
            "title": "Top Categories",
            "type": "array"
          },
          "user_id": {
            "description": "User unique identifier",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "content_type",
          "interaction_count",
          "positive_count"
        ],
        "title": "UserProfileResponse",
        "type": "object"
      },
      "UserSummary": {
        "description": "User summary for user selection lists.",
        "properties": {
          "interaction_count": {
            "default": 0,
            "description": "Total interaction count",
            "title": "Interaction Count",
            "type": "integer"
          },
          "is_demo": {
            "default": false,
            "description": "Whether selected as a curated demo user",
            "title": "Is Demo",
